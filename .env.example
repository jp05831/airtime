# Optional embedded-app setting; AIRTIME's private account-bound integration leaves this blank.
VIBE_ACCOUNT_ID=
VIBE_LIVE_MODE=false
# Required whole-dollar CPM optimization parameter; not an audience/delivery estimate.
VIBE_CPM_TARGET_CENTS=2000
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
DEMO_MODE=false
# Optional server-only FFprobe override. Vercel uses the bundled static Linux binary by default.
FFPROBE_PATH=
# Optional backend-only CoinGecko demo API key
COINGECKO_API_KEY=
# Legacy single-token settings are intentionally no longer required.
# Existing legacy records remain archived in the original tables.
